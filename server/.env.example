# Copy to server/.env and fill in the LLM values.

LITELLM_BASE_URL=
LITELLM_API_KEY=
JUSPAY_API_KEY=

# Optional model defaults.
OPENCODE_PIPELINE_MODEL=litellm/kimi-latest
OPENCODE_PIPELINE_CONTEXT_LIMIT=256000
OPENCODE_PIPELINE_OUTPUT_LIMIT=32000

# The checked-in Compose default is the ARM64 image used by the source setup.
# Set TEI_IMAGE to the matching CPU image for a different Docker architecture.
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
