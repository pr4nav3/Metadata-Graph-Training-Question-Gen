# Non-secret defaults for the standalone metadata-knowledge-graph question pipeline.
# `run_with_server_env.sh` sources `server/.env` first, then this file.

METADATA_KG_VESPA_FEED_PORT=${METADATA_KG_VESPA_FEED_PORT:-18080}
METADATA_KG_VESPA_QUERY_PORT=${METADATA_KG_VESPA_QUERY_PORT:-18081}
METADATA_KG_VESPA_CONFIG_PORT=${METADATA_KG_VESPA_CONFIG_PORT:-19072}
METADATA_KG_POSTGRES_PORT=${METADATA_KG_POSTGRES_PORT:-15432}

METADATA_KG_VESPA_CONTAINER=${METADATA_KG_VESPA_CONTAINER:-metadata-kg-vespa}
METADATA_KG_TEI_CONTAINER=${METADATA_KG_TEI_CONTAINER:-metadata-kg-tei-batch-proxy}
METADATA_KG_POSTGRES_CONTAINER=${METADATA_KG_POSTGRES_CONTAINER:-metadata-kg-xyne-db}
METADATA_KG_REQUIRED_CONTAINERS=${METADATA_KG_VESPA_CONTAINER},${METADATA_KG_TEI_CONTAINER}

METADATA_KG_VESPA_FEED_URL=${METADATA_KG_VESPA_FEED_URL:-http://localhost:${METADATA_KG_VESPA_FEED_PORT}}
METADATA_KG_VESPA_QUERY_URL=${METADATA_KG_VESPA_QUERY_URL:-http://localhost:${METADATA_KG_VESPA_QUERY_PORT}/search/}

